# OxideMUD VPS Connection Settings
# Copy this file to '.env' in either the repository root or the 'ansible/' directory.

# The IP address or domain name of your VPS
VPS_HOST=192.168.1.100

# SSH connection details
VPS_USER=root
VPS_PORT=22
VPS_KEY_PATH=~/.ssh/id_rsa

# Remote deployment configurations
INSTALL_DIR=/opt/oxide
RUN_AS_USER=oxide
INSTALL_GAME_SERVICE=true
INSTALL_MCP_SERVICE=true
