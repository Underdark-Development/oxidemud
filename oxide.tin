#alias {reconnect} {#session oxide localhost 4000}

#event {SESSION CONNECTED} {
    #nop Connected to server.
}

#event {SESSION DISCONNECTED} {
    #say {Connection lost. Type "reconnect" to resume.}
}

#session oxide localhost 4000
#config {char subtitle} {Oxide MUD}
#config {auto wrap} {off}
#config {history lines} {500}

#nop Telnet echo is controlled by server via IAC WILL/WONT ECHO.
#nop Normal gameplay: server sends WONT ECHO → TinTin++ shows what you type.
#nop Password prompts: server sends WILL ECHO → TinTin++ hides input.
